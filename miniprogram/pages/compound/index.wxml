<navigation-bar title="复利计算器" back="{{true}}" color="#222" background="#fff"></navigation-bar>
<view class="compound-container">
	<view class="form-item">
		<text class="label">初始本金(元)</text>
		<input class="input" type="digit" placeholder="请输入初始本金" value="{{principal}}" bindinput="onInputChange" data-key="principal" />
	</view>
	<view class="form-item">
		<text class="label">年化利率(%)</text>
		<input class="input" type="digit" placeholder="请输入年化利率" value="{{rate}}" bindinput="onInputChange" data-key="rate" />
	</view>
	<view class="form-item">
		<text class="label">投资年数</text>
		<input class="input" type="number" placeholder="请输入年数" value="{{years}}" bindinput="onInputChange" data-key="years" />
	</view>
	<button class="calc-btn" type="primary" bindtap="onCalc">计算</button>
	<view class="result-area" wx:if="{{result !== null}}">
		<text>复利终值：<text class="result">{{result}}</text> 元</text>
	</view>
</view>